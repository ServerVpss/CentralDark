# .graphifyignore — o que o Graphify NAO deve indexar
# Formato: um padrao glob por linha. Comentarios comecam com #.
#
# Objetivo: manter o grafo do CentralDark limpo. Sem esses ignores o grafo
# vira lixo (node_modules, caches, chaves, docs longas, arquivos gerados).
#
# Versao consolidada (Pivete + Lovable + Claude + Gemini via darkai).

# Dependencias e artefatos de build
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.next/
**/.next/
.nuxt/
.output/
.turbo/
.cache/
**/.cache/
.vite/
**/.vite/
coverage/
**/coverage/
.parcel-cache/
.svelte-kit/

# Runtime, logs e temporarios
logs/
**/logs/
*.log
tmp/
**/tmp/
.tmp/
**/.tmp/
mem/
root/
quarantine/
install-callback/

# Backups e snapshots antigos
revisoes/
**/revisoes/
*.bak
*.bak.*
*.backup
backups/
snapshots/

# CI/CD runners e binarios de infra
actions-runner/
**/actions-runner/
.github/actions/*/dist/

# Chaves e credenciais (nunca indexar)
secrets/
**/secrets/
.env
.env.*
*.pem
*.key
*.crt
credentials/
tokens/
sessions/
.claude-proxy/

# WhatsApp / WuzAPI
whatsapp-sessions/
wuzapi-data/
**/whatsapp-server/data/
**/*session*.json

# Bancos locais e dumps
*.sqlite
*.sqlite3
*.db
dump.sql
*.dump

# Docs auto-geradas e relatorios repetitivos
docs/RELATORIOS/notion-sync/*.md
docs/RELATORIOS/**/*.log
graphify-out/
graphify-debug.log*

# Sistema, editor, OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Areas protegidas (CLAUDE.md secao 9) que nao precisam indexar
apps/modulos/mcp/dist/
apps/modulos/mcp/node_modules/
apps/modulos/Bolt/dist/
apps/modulos/Bolt/node_modules/
apps/modulos/WebUI/dist/
apps/modulos/WebUI/node_modules/

# Contas / dados de usuario
contas/
**/contas/

# Docker runtime dentro de modulos (containers, snapshots, logs — dezenas de GB)
apps/modulos/WebUI/var/
**/WebUI/var/
**/var/lib/docker/
**/var/lib/containerd/
