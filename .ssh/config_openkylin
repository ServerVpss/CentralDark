# CentralDark: openKylin no WSL2. SSH sem abrir porta no Windows; inicia a distro sozinho.
# Uso: ssh -F ~/.ssh/config_openkylin openkylin   (ou: openkylin-ssh.cmd)
Host openkylin
    User openkylin
    IdentityFile ~/.ssh/id_ed25519_openkylin
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    ServerAliveInterval 30
    ProxyCommand wsl.exe -d openKylin -u root --exec //usr/sbin/sshd -i

# CentralDark | VMware openKylin 3.0 (separate from WSL Host openkylin above)
# VMX: E:/VMs/CENTRALDARK-OS/CENTRALDARK-OSh.vmx
Host openkylin-vm CentralDark-OS-VM
    HostName 192.168.35.130
    User CentralDark-OS
    IdentityFile ~/.ssh/id_ed25519_openkylin
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    ServerAliveInterval 30

# CENTRALDARK | acesso administrativo por chave, restrito na VM a 192.168.35.1
Host openkylin-root
    HostName 192.168.35.130
    User root
    IdentityFile ~/.ssh/id_ed25519_openkylin
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    ServerAliveInterval 30
