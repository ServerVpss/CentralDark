{
  "name": "centraldark-vscode-restore",
  "displayName": "CentralDark · Vibe Coding",
  "description": "CentralDark VS Code: OAuth CentralDark compartilhado, bancada e pareamento por codigo.",
  "version": "0.2.3",
  "publisher": "centraldark",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "centraldark.restoreWorkspace",
        "title": "CentralDark: Restaurar bancada"
      },
      {
        "command": "centraldark.mapWorkspace",
        "title": "CentralDark: Mapear interface (read-only)"
      },
      {
        "command": "centraldark.showProjectFolders",
        "title": "CentralDark: Mostrar pastas do projeto (nativo)"
      },
      {
        "command": "centraldark.zendriveCli",
        "title": "CentralDark: ZENDRIVE CLI (terminal existente)"
      },
      {
        "command": "centraldark.showTrace",
        "title": "CentralDark: Mostrar Trace (Saída)"
      },
      {
        "command": "centraldark.focusExistingTerminal",
        "title": "CentralDark: VS Code — focar terminal existente"
      },
      {
        "command": "centraldark.probeVpsSsh",
        "title": "CentralDark: Testar rota SSH Casa → VPS (Tailscale / pública)"
      },
      {
        "command": "centraldark.connectVpsSsh",
        "title": "CentralDark: Conectar VPS via Remote SSH (mesma identidade)"
      },
      {
        "command": "centraldark.locateVsCodeByPid",
        "title": "CentralDark: Localizar VS Code por PID (PowerShell / terminal)"
      },
      {
        "command": "centraldark.browserSurfacesCatalog",
        "title": "CentralDark: Catálogo de abas e capacidades Browser/ZENDRIVE"
      },
      {
        "command": "centraldark.pairVsCode",
        "title": "CentralDark: Parear este VS Code (SSH + MCP)"
      },
      {
        "command": "centraldark.verifyVsCodePairing",
        "title": "CentralDark: Verificar pareamento MCP"
      },
      {
        "command": "centraldark.remoteTerminalPair",
        "title": "CentralDark: Parear receptor de terminal remoto (opt-in)"
      },
      {
        "command": "centraldark.remoteTerminalStatus",
        "title": "CentralDark: Status receptor remoto e PIDs (somente leitura)"
      },
      {
        "command": "centraldark.checkUpdates",
        "title": "CentralDark: Checar atualizacao via API GitHub"
      }
    ],
    "configuration": {
      "title": "CentralDark Restore",
      "properties": {
        "centraldark.restore.onOpen": {
          "type": "boolean",
          "default": false,
          "description": "Restaura a bancada automaticamente ao abrir o VS Code."
        },
        "centraldark.restore.startAgents": {
          "type": "boolean",
          "default": false,
          "description": "Executa os comandos dos terminais (hermes chat, claude) ao restaurar."
        },
        "centraldark.restore.terminalTelemetry": {
          "type": "boolean",
          "default": true,
          "description": "Registra somente inicio/fim/resultado de shell integrado no LOGS-VS-CODE.log da Casa; nunca grava comandos ou saidas."
        },
        "centraldark.restore.remoteTerminalEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Habilita receptor privado em localhost somente apos pareamento e consentimento local."
        },
        "centraldark.restore.remoteTerminalPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "default": 8719,
          "description": "Porta HTTP em 127.0.0.1 para uso privado; nao expoe diretamente na rede."
        },
        "centraldark.restore.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Ativa verificacao de releases a cada 10 minutos, com prompt antes de instalar."
        },
        "centraldark.restore.autoUpdateIntervalMinutes": {
          "type": "integer",
          "default": 10,
          "minimum": 5,
          "maximum": 1440,
          "description": "Intervalo de checagem, em minutos."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "centraldarkVibe",
          "title": "CentralDark Vibe Coding",
          "icon": "media/centraldark-activity.svg"
        }
      ]
    },
    "views": {
      "centraldarkVibe": [
        {
          "id": "centraldarkVibeCoding",
          "name": "CentralDark · Vibe Coding",
          "type": "webview"
        },
        {
          "id": "centraldarkWorkspaceFolders",
          "name": "Pastas do projeto"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  },
  "extensionKind": [
    "ui"
  ]
}
