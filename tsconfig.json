{
  "compilerOptions": {
    "allowJs": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/compartilhado/ui/*": ["./src/compartilhado/interface/*"],
      "@/compartilhado/ui": ["./src/compartilhado/interface"],
      "@/compartilhado/hooks/*": ["./src/compartilhado/comportamentos/*"],
      "@/compartilhado/hooks": ["./src/compartilhado/comportamentos"],
      "@/compartilhado/lib/*": ["./src/compartilhado/utilitarios/*"],
      "@/compartilhado/lib": ["./src/compartilhado/utilitarios"],
      "@/preview/cockpit-hero/*": ["./src/admin/cockpit/*"],
      "@/preview/cockpit-hero": ["./src/admin/cockpit"],
      "@/funcionalidades/hermes-panel/*": ["./src/funcionalidades/hermes/*"],
      "@/*": ["./src/*"]
    },

    "skipLibCheck": true,
    "strictNullChecks": false
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
