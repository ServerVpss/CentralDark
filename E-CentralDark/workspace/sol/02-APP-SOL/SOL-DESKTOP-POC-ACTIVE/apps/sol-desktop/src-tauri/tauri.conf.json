{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SOL CentralDark",
  "version": "0.1.0",
  "identifier": "com.centraldark.sol",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SOL · CentralDark",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* https://api.centraldark.com; media-src 'self' blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
