{
  "name": "@overclock-app/sidecar",
  "version": "0.1.0",
  "description": "Node sidecar — WebSocket host serving Overclock core for Tauri migration",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.198",
    "@overclock-app/bus": "workspace:*",
    "@overclock-app/catalog": "workspace:*",
    "@overclock-app/core": "workspace:*",
    "@overclock-app/mcp": "workspace:*",
    "@overclock-app/ipc-types": "workspace:*",
    "@overclock-app/pty": "workspace:*",
    "@xhayper/discord-rpc": "^1.3.4",
    "selfsigned": "^5.5.0",
    "undici": "^7.28.0",
    "ws": "^8.21.0",
    "yaml": "^2.7.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.3",
    "vitest": "^3.1.4"
  }
}
