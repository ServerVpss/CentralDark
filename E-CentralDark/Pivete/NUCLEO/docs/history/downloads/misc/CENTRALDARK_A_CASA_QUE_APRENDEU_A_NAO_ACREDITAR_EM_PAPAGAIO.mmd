flowchart TD
    CHEFE["SEGREDO / CHEFE<br/>INTENÇÃO"] --> CASA["CENTRALDARK<br/>A CASA"]

    subgraph PERCEPCAO["PERCEPÇÃO E TRIAGEM"]
        INPUTS["Arquivos • Screens • Conversas • Logs • Eventos"]
        FILTRO["Triagem / Filtro<br/>ruído → contexto → evidência"]
        INPUTS --> FILTRO
