    LEARN --> MEM["Memória / Grafo<br/>fatos • decisões • causas • provas"]
    MEM --> TRAJ["Trajetória / Narrativa<br/>EVENTOS → DREAM REVIEW → HISTÓRIA"]
    TRAJ --> NEXT["NEXT BOOT<br/>LAST_GOOD_STATE"]
    NEXT --> CASA

    PAP["PAPAGAIO<br/>ruído • eco • repetição"] -. "REPETIÇÃO != COMPREENSÃO" .-> FILTRO

    RULES["INVARIANTES<br/>REALITY = JUDGE<br/>UNKNOWN != PASS<br/>ACTION != PROOF<br/>HISTORY != CURRENT_STATE"] --- JUDGE
