    {"id":"chatgpt-cowork","owner":"external-work-owner","transport":"Work/browser","runtime_status":"UNKNOWN"},
    {"id":"vscode","owner":"apps/modulos/HERMES-CORE/extensions/hermes-vscode-router-provider","transport":"VS Code Remote","runtime_status":"PROVEN"},
    {"id":"figma","owner":"Figma connector","transport":"MCP","runtime_status":"PROVEN"},
    {"id":"obsidian","owner":"apps/modulos/obsidian-plugin-grafo-vivo","transport":"Grafo Vivo","runtime_status":"UNKNOWN"}
