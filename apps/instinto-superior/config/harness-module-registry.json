  "reuse_before_create": true,
  "modules": [
    {"id":"deepseek","owner":"apps/modulos/deepseek-harness","transport":"existing-owner","runtime_status":"PROVEN"},
    {"id":"hermes","owner":"apps/modulos/HERMES-CORE","transport":"MCP/RDC","runtime_status":"PROVEN"},
