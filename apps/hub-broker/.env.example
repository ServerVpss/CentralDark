# =======================================
# hub-broker — variáveis obrigatórias
# Copiar pra /root/CentralDark/apps/hub-broker/.env na VPS
# =======================================

# Porta interna (Caddy proxya pra ela)
HUB_BROKER_PORT=8790
HUB_BROKER_PUBLIC_BASE=https://hub.centralldark.com

# Supabase HUB (lyoigsqluyktoclwdaft)
HUB_SUPABASE_URL=https://lyoigsqluyktoclwdaft.supabase.co
HUB_SUPABASE_SERVICE_ROLE_KEY=

# Chave AES-256-GCM (hex, 64 chars = 32 bytes). Gerar com:
#   openssl rand -hex 32
HUB_ENCRYPTION_KEY=

# Token interno pra edge functions do HUB chamarem /api/get-token
HUB_INTERNAL_TOKEN=

# Origens autorizadas (CORS) — separadas por vírgula
HUB_ALLOWED_ORIGINS=https://centraldark.lovable.app,http://localhost:8080

# OAuth GitHub (já existe no CentralDark)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth Notion (criar em https://www.notion.so/my-integrations → "Public integration")
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# OAuth Google Drive (criar em https://console.cloud.google.com → OAuth 2.0 Client ID)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
