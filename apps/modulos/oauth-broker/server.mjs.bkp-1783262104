// Converte user_id não-UUID (ex: "dev-pivete") em UUID v5 determinístico
function toUuid(id) {
  if (/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(id))) return id;
  const h = crypto.createHash("sha1").update("centraldark:" + String(id)).digest("hex");
  return `${h.slice(0,8)}-${h.slice(8,12)}-5${h.slice(13,16)}-8${h.slice(17,20)}-${h.slice(20,32)}`;
}

const KEY = crypto.createHash("sha256").update(VAULT_MASTER_KEY).digest();
function encrypt(plain) {
  const iv = crypto.randomBytes(12);
  const cipher = crypto.createCipheriv("aes-256-gcm", KEY, iv);
  const enc = Buffer.concat([cipher.update(plain, "utf8"), cipher.final()]);
  const tag = cipher.getAuthTag();
  return Buffer.concat([iv, tag, enc]);
}

const PROVIDERS = {
  google:  { clientEnv: "GOOGLE_CLIENT_ID",   secretEnv: "GOOGLE_CLIENT_SECRET" },
  drive:   { clientEnv: "GOOGLE_CLIENT_ID",   secretEnv: "GOOGLE_CLIENT_SECRET" },
  docs:    { clientEnv: "GOOGLE_CLIENT_ID",   secretEnv: "GOOGLE_CLIENT_SECRET" },
  gdrive:  { clientEnv: "GOOGLE_CLIENT_ID",   secretEnv: "GOOGLE_CLIENT_SECRET" },
  notion:  { clientEnv: "NOTION_CLIENT_ID",   secretEnv: "NOTION_CLIENT_SECRET" },
  github:  { clientEnv: "GITHUB_CLIENT_ID",   secretEnv: "GITHUB_CLIENT_SECRET" },
  openai:  { clientEnv: "OPENAI_CLIENT_ID",   secretEnv: "OPENAI_CLIENT_SECRET" },
  grok:    { clientEnv: "GROK_CLIENT_ID",     secretEnv: "GROK_CLIENT_SECRET"   },
};

async function notifyHermes(event, detail) {
  try {
    const inbox = "/root/CentralDark/revisoes/hermes-watch/inbox";
    const fsp = await import("node:fs/promises");
    await fsp.mkdir(inbox, { recursive: true });
    const file = `${inbox}/oauth-${Date.now()}-${crypto.randomBytes(3).toString("hex")}.json`;
    await fsp.writeFile(file, JSON.stringify({ src: "oauth-broker", event, detail, ts: new Date().toISOString() }, null, 2));
  } catch (e) { console.error("hermes notify falhou", e.message); }
}

const app = express();
