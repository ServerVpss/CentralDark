{
  "data_dir": ".centraldark-fp",
  "policy": {
    "required_domains": ["local", "vps", "github", "screenpipe"],
    "required_stable_samples": 2,
    "sample_interval_seconds": 15,
    "max_rounds": 12,
    "max_observation_age_seconds": 120,
    "max_open_promotion_prs": 30
  },
  "local": {
    "repo_path": "K:/",
    "services": [
      {"name": "dashboard", "url": "http://127.0.0.1:8792/health"}
    ]
  },
  "vps": {
    "heartbeat_url": "http://100.123.93.25:9100/health",
    "hmac_secret": "",
    "max_age_seconds": 120,
    "timeout_seconds": 5
  },
  "github": {
    "repository": "ServerVpss/CentralDark",
    "branch": "main",
    "token_env": "GITHUB_TOKEN"
  },
  "github_webhook": {
    "secret_env": "CENTRALDARK_GITHUB_WEBHOOK_SECRET",
    "bind": "127.0.0.1",
    "port": 8790
  },
  "screenpipe": {
    "base_url": "http://127.0.0.1:3030",
    "recent_seconds": 300
  }
}