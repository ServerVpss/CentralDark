{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CentralDark Fixed Point Fabric",
  "type": "object",
  "required": ["policy", "local", "vps", "github", "screenpipe"],
  "properties": {
    "data_dir": {"type": "string"},
    "policy": {
      "type": "object",
      "required": ["required_domains", "required_stable_samples"],
      "properties": {
        "required_domains": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "required_stable_samples": {"type": "integer", "minimum": 2},
        "sample_interval_seconds": {"type": "number", "minimum": 1},
        "max_rounds": {"type": "integer", "minimum": 2},
        "max_observation_age_seconds": {"type": "integer", "minimum": 1},
        "max_open_promotion_prs": {"type": "integer", "minimum": 1, "maximum": 1}
      }
    },
    "local": {"type": "object"},
    "vps": {"type": "object"},
    "github": {"type": "object"},
    "github_webhook": {
      "type": "object",
      "properties": {
        "secret_env": {"type": "string"},
        "bind": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "screenpipe": {"type": "object"}
  }
}
