{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CentralDark Halo",
  "version": "0.1.8",
  "identifier": "com.centraldark.halo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost https://lyoigsqluyktoclwdaft.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": { "nsis": { "installMode": "both" } },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
