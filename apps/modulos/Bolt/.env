# --- CONFIGURAÇÃO DE PORTA ---
PORT=5173

# --- OPENROUTER (Obrigatório para o seu fluxo atual) ---
# Modelo sugerido para teste: google/gemini-flash-1.5-free
# Ou o seu favorito: anthropic/claude-3.5-sonnet
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=google/gemini-flash-1.5-free

# --- OUTROS PROVEDORES (Opcional - Deixe vazio se não tiver a Key) ---
GROQ_API_KEY=
HuggingFace_API_KEY=
TOGETHER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=

# --- CONFIGURAÇÕES DE INTERFACE (VITE) ---
VITE_LOG_LEVEL=info
NODE_ENV=production

# --- HABILITAR PROVEDORES NA TELA (Mude para false se quiser esconder algum) ---
ENABLE_OPENROUTER=true
ENABLE_GROQ=true
ENABLE_HUGGINGFACE=true
ENABLE_OPENAI=true
ENABLE_ANTHROPIC=true
ENABLE_TOGETHER=true

# --- CONFIGURAÇÃO DE TOKENS ---
DEFAULT_NUM_PREDICT_TOKENS=1024








