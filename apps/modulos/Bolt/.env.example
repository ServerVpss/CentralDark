# CentralDark Builder (Bolt) — modelo de variáveis
#
# Copie para `source/.env` e preencha os valores. NUNCA versione o `.env` real.
#   cp apps/modulos/Bolt/.env.example apps/modulos/Bolt/source/.env
#
# O `docker-compose.yml` deste módulo declara `env_file: ./source/.env`,
# então o arquivo precisa existir antes de `docker compose up`.
#
# Este arquivo contém APENAS nomes de variáveis — nenhum valor real.

# ─────────────────────────────────────────────────────────────
# Provider ativo — gateway CentralDark (OpenAI-compatible)
# ─────────────────────────────────────────────────────────────
# Único caminho de modelo comprovadamente cabeado.
# Verificado de dentro do container: HTTP 200 em /v1/models.
OPENAI_LIKE_API_BASE_URL=
OPENAI_LIKE_API_KEY=

# ─────────────────────────────────────────────────────────────
# Anthropic — direto na API oficial
# ─────────────────────────────────────────────────────────────
# ATENÇÃO: o provider Anthropic do bolt.diy NÃO aceita base URL
# customizada. `app/lib/modules/llm/providers/anthropic.ts` não declara
# `baseUrlKey` e nunca passa `baseURL` para `createAnthropic()`.
#
# Logo, `ANTHROPIC_API_BASE_URL` (presente no docker-compose.yml) é
# IGNORADA pelo código — o tráfego vai direto para api.anthropic.com,
# não para o Elite Gateway local. Roteá-lo pelo gateway exige alterar
# o provider, não configurar variável.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# Runtime / preview
# ─────────────────────────────────────────────────────────────
# O compose já define PORT, HOST, VITE_HMR_* e PUBLIC_ORIGIN.
# Ajuste aqui só se rodar fora do docker-compose deste módulo.
VITE_LOG_LEVEL=

# ─────────────────────────────────────────────────────────────
# Outros providers do bolt.diy (opcionais — deixe vazio se não usar)
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GROQ_API_KEY=
OPEN_ROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OLLAMA_API_BASE_URL=
TOGETHER_API_BASE_URL=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
