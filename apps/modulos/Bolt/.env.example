# CentralDark Builder Bolt — exemplo público de configuração
# Copie para um arquivo de ambiente seguro somente na VPS se realmente precisar.
# Nunca commite valores reais de API keys, tokens ou secrets.

# Porta interna esperada pelo bolt.diy dentro do container.
BOLT_INTERNAL_PORT=5173

# Porta local bindada somente em localhost para o Caddy fazer proxy.
BOLT_HOST_BIND=127.0.0.1
BOLT_HOST_PORT=5174

# Origem pública usada pelo navegador depois do proxy Caddy.
PUBLIC_ORIGIN=https://builder.centralldark.com

# Fonte oficial do bolt.diy. O script de deploy clona esse repo dentro de ./source na VPS.
BOLT_REPO_URL=https://github.com/stackblitz-labs/bolt.diy.git
BOLT_REF=main

# Opcional: ajuste se o Dockerfile oficial exigir um alvo específico no futuro.
# Por padrão o compose não fixa target para reduzir quebra quando o upstream mudar.
# BOLT_DOCKER_TARGET=
