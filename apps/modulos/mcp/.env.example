# MCP — CentralDark
# Copie este arquivo para /root/CentralDark/secrets/mcp.env e preencha os valores reais.
# NUNCA commite o arquivo .env real.

# Servidor
MCP_PORT=9100
MCP_PUBLIC_URL=https://mcp.centralldark.com

# GitHub OAuth (App: "Segredo Unlock Admin")
GITHUB_CLIENT_ID=Ov23li1y2mZ3qbjVB4mC
GITHUB_CLIENT_SECRET=COLE_AQUI_O_CLIENT_SECRET_DO_GITHUB
GITHUB_OAUTH_CALLBACK=https://mcp.centralldark.com/oauth/callback
GITHUB_OAUTH_SCOPES=repo workflow read:org

# Segurança
# Gere com: openssl rand -hex 32
MCP_SESSION_SECRET=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS_AQUI

# Persistência de OAuth (clients/codes/tokens) — sobrevive a restart do PM2
# Padrão: /root/CentralDark/secrets/mcp-state.json (permissão 0600)
MCP_STATE_FILE=/root/CentralDark/secrets/mcp-state.json

# Contexto do Repo (padrões pras tools quando owner/repo não forem passados)
GITHUB_OWNER=segredounlock
GITHUB_REPO=clone-deck

# VPS — caminhos dentro da nova estrutura /root/CentralDark/
# O repo clone-deck ainda vive em /root/Multizap/apps/clone-deck enquanto a migração não termina.
# Quando migrar, atualizar VPS_REPO_PATH para /root/CentralDark/modulos/multizap/
VPS_REPO_PATH=/root/Multizap/apps/clone-deck
PM2_ALLOWED_RESTART=CloneDeck-Supabase-Sync,MultiZap-TelegramBot

# Logs
LOG_LEVEL=info
LOG_DIR=/root/CentralDark/logs/mcp

# ─────────────────────────────────────────────────────────────────────
# INTEGRAÇÕES NATIVAS (Linear / Notion / Sentry)
# Estratégia: fallback automático → tenta token direto; se faltar, usa
# o Lovable Connector Gateway via LOVABLE_API_KEY.
# Cole só o que você tem. O resto cai pro gateway sozinho.
# ─────────────────────────────────────────────────────────────────────

# Linear — Personal API Key (https://linear.app/settings/api)
LINEAR_API_KEY=

# Notion — Internal Integration Token (https://www.notion.so/profile/integrations)
NOTION_API_KEY=

# Sentry — Auth Token com scopes event:read, project:read, org:read
# https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
SENTRY_ORG=

# Fallback universal pro gateway da Lovable (auto-provisionado em projetos Lovable)
LOVABLE_API_KEY=

