# ─────────────────────────────────────────────────────────────
# Lovable Proxy — variaveis obrigatorias
# ─────────────────────────────────────────────────────────────
# Copie para .env e preencha. NUNCA commitar o .env real.
# Sem esta chave o proxy nao sobe (exit 1) e o Setor de
# Inteligencia fica com o teste "chat" em aguardando_chave.

LOVABLE_API_KEY=
# opcional: token interno pra validar clientes VPS
PROXY_INTERNAL_TOKEN=
# opcional: porta (default 3102)
PORT=3102
