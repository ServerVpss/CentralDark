# === Monitoramento 24h — MODELO de variaveis (este arquivo PODE ser versionado) ===
# Copie para ".env" (que NAO e versionado) e preencha. O .env real fica chmod 600.

# Telegram (Guardiao-Notificacoes)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ponto unico de plug das IAs (MCP) — provedor-agnostico (Claude/GPT/Grok/Mistral...)
MCP_ENDPOINT=

# Porta do nucleo/servidor que o painel (Hub) consome (Fase 3)
NUCLEO_PORT=3210
