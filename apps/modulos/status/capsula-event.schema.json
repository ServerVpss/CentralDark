{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://centralldark.com/schemas/capsula-event.schema.json",
  "title": "CentralDark Capsule Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capsule_id",
    "run_id",
    "mission_id",
    "iteration",
    "timestamp_utc",
    "phase",
    "candidate_ref",
    "candidate_digest",
    "baseline_ref",
    "fixture_ref",
    "evaluator_ref",
    "writer",
    "action",
    "status",
    "reason",
    "chief_decision",
    "tests",
    "evidence_hash",
    "failure_observed",
    "failure_fingerprint",
    "new_failure_class",
    "correction_verified",
    "retained_after_retest",
    "false_green_found",
    "regression_found"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "capsule_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "mission_id": { "type": "string", "minLength": 1 },
    "iteration": { "type": "integer", "minimum": 1 },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "phase": { "enum": ["PLAN", "ACT", "OBSERVE", "CRITIQUE", "REFINE", "DECIDE"] },
    "candidate_ref": { "type": "string", "minLength": 1 },
    "candidate_digest": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "baseline_ref": { "type": "string", "minLength": 1 },
    "fixture_ref": { "type": "string", "minLength": 1 },
    "evaluator_ref": { "type": "string", "minLength": 1 },
    "writer": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PASS", "FAIL", "UNKNOWN", "ANOMALY", "ACHADO_PENDENTE", "BLOCKED"] },
    "reason": {
      "enum": ["", "CAPTURE_DEGRADED", "SECRET_EXPOSURE", "SANITIZE_FAILED", "SKIPPED", "GATE_FAILED", "AUTH_MISSING", "NO_EVENTS", "INVALID_EVENT", "CANDIDATE_DRIFT", "EVALUATOR_NOT_INDEPENDENT"]
    },
    "chief_decision": { "enum": ["PENDING", "APPROVED", "REJECTED"] },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "pass", "fail", "skipped"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "failure_observed": { "type": "boolean" },
    "failure_fingerprint": { "type": "string" },
    "new_failure_class": { "type": "boolean" },
    "correction_verified": { "type": "boolean" },
    "retained_after_retest": { "type": "boolean" },
    "false_green_found": { "type": "boolean" },
    "regression_found": { "type": "boolean" },
    "generalization": { "$ref": "#/$defs/ratio" },
    "retention": { "$ref": "#/$defs/ratio" }
  },
  "$defs": {
    "ratio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "total"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
