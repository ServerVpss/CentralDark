[Unit]
Description=CentralDark Remote Desktop Commander bridge (conta2)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/root/CentralDark
Environment=HOME=/root/.desktop-commander-profiles/conta2
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart=/usr/bin/npx -y @wonderwhy-er/desktop-commander@0.2.48 remote
Restart=always
RestartSec=5s
TimeoutStartSec=0
TimeoutStopSec=15
RuntimeMaxSec=12h

[Install]
WantedBy=multi-user.target
