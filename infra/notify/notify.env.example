# /etc/centraldark/notify.env
# Permissões obrigatórias: chmod 600 (só root lê)
#
# Onde achar os valores:
#   NOTIFY_URL      = https://<seu-projeto>.supabase.co/functions/v1/notify-telegram
#   NOTIFY_API_KEY  = peça à Lovable (foi gerada via secrets--generate_secret)
#
# IMPORTANTE: nunca commite este arquivo preenchido — só este .example fica no repo.

NOTIFY_URL="https://EXEMPLO.supabase.co/functions/v1/notify-telegram"
NOTIFY_API_KEY="cole-aqui-o-valor-real-da-secret-NOTIFY_API_KEY"
