  "arm_router": {
    "owner": "scripts/trigger-fabric/workflow-family-dispatcher.mjs",
    "model": "CAPABILITY -> ARM_ROUTER -> ELIGIBLE_ARM -> SAME_TARGET -> EVIDENCE -> FALLBACK",
    "invariants": {
      "REUSE_BEFORE_CREATE": true,
      "FALLBACK_BEFORE_NEW_CAPABILITY": true,
      "ARM_FAILURE_IS_CAPABILITY_FAILURE": false,
      "TRANSPORT_FAILURE_IS_CAPABILITY_FAILURE": false,
      "UNKNOWN_IS_NOT_PASS": true,
      "CURRENT_OVER_HISTORY": true
    },
    "arms": {
      "GITHUB_WORKFLOW_DISPATCH": {
        "owner": "scripts/trigger-fabric/workflow-family-dispatcher.mjs",
        "route": "GITHUB_ACTIONS_WORKFLOW_DISPATCH",
        "evidence_required": [
          "HTTP_204_ACCEPTED",
          "WORKFLOW_PATH",
          "REF",
          "TARGET_FINGERPRINT"
        ],
        "failure_class": "TRANSPORT_ROUTE_FAILURE",
        "fallback_order": 10,
        "same_target_remeasurement": "WORKFLOW_PATH+REF+TARGET_FINGERPRINT",
        "eligible": true
      },
      "GITHUB_REPOSITORY_DISPATCH": {
        "owner": "scripts/trigger-fabric/workflow-family-dispatcher.mjs",
        "route": "GITHUB_REPOSITORY_DISPATCH",
        "evidence_required": [
          "HTTP_204_ACCEPTED",
          "EVENT_TYPE",
          "TARGET_FINGERPRINT"
        ],
        "failure_class": "TRANSPORT_ROUTE_FAILURE",
        "fallback_order": 20,
        "same_target_remeasurement": "EVENT_TYPE+CAPABILITY_ID+TARGET_FINGERPRINT",
        "eligible": true
      },
      "VPS_LOCAL_COMMAND": {
        "owner": "SELF_HOSTED_VPS_EXISTING_RUNNER",
        "route": "LOCAL_COMMAND_EXISTING_OWNER",
        "evidence_required": [
          "COMMAND",
          "EXIT_CODE",
          "STDOUT_STDERR",
          "WORKTREE_HEAD",
          "TARGET_FINGERPRINT"
        ],
        "failure_class": "LOCAL_EXECUTION_RESULT",
        "fallback_order": 30,
        "same_target_remeasurement": "COMMAND_FINGERPRINT+WORKTREE_HEAD+TARGET_FINGERPRINT",
        "eligible": true
      },
      "HERMES_MISSION_QUEUE": {
        "owner": "apps/modulos/HERMES-CORE/core/orchestrator.mjs",
        "route": "apps/modulos/HERMES-CORE/missions/pendente",
        "evidence_required": [
          "MISSION_FILE",
          "ORCHESTRATOR_PICKUP",
          "FINALIZATION_RECEIPT",
          "TARGET_FINGERPRINT"
        ],
        "failure_class": "VPS_AUTONOMOUS_ROUTE",
        "fallback_order": 40,
        "same_target_remeasurement": "REQUIRED_BEFORE_ELIGIBLE",
        "eligible": false,
        "reason": "RUNTIME_QUEUE_PROVEN_BUT_CAPABILITY_SAME_TARGET_MAPPING_NOT_PROVEN"
      }
    }
  }
