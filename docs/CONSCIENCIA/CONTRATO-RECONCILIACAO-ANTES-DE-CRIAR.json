{
  "schema_version": 1,
  "contract_id": "CENTRALDARK_RECONCILIATION_BEFORE_CREATION",
  "status": "CANONICAL",
  "marker": "REUSE_BEFORE_CREATE_REQUIRED",
  "applies_to": [
    "chatgpt",
    "claude",
    "codex",
    "gemini",
    "copilot",
    "cursor",
    "windsurf",
    "hermes",
    "plugins",
    "future_agents"
  ],
  "mandatory_pre_solution_sequence": [
    "resolve_user_intent",
    "search_existing_capabilities",
    "open_primary_implementation_files",
    "cross_reference_capabilities_with_request",
    "classify_authority_and_runtime_state",
    "reuse_or_extend_before_create"
  ],
  "state_classes": [
    "CANONICAL",
    "OPERATIONAL",
    "CANDIDATE",
    "PROGRAM_ONLY",
    "HISTORICAL",
    "UNKNOWN"
  ],
  "decision_rules": {
    "existing_capability_satisfies_request": "REUSE",
    "existing_capability_partially_satisfies_request": "EXTEND_MINIMALLY",
    "new_component_requires_proved_gap": true,
    "proposal_without_inventory": "BOOT_BLOCKED",
    "file_found_but_not_cross_referenced": "CONTEXT_RECONCILIATION_FAILURE",
    "open_or_draft_pr_is_operational_authority": false,
    "program_document_is_runtime_proof": false,
    "existing_path_is_runtime_proof": false,
    "formal_proof_without_user_request": "FORBIDDEN_FOR_SIMPLE_TASKS"
  },
  "complexity_policy": {
    "simple_local_clear_reversible": "DIRECT_MINIMAL_ACTION",
    "broad_uncertain_multilayer_or_high_risk": "DELTA_WITH_INDEPENDENT_REVIEW",
    "never_expose_internal_governance_as_user_bureaucracy": true
  },
  "correction_learning_policy": {
    "marker": "CORRECTION_LEARNING_REQUIRED",
    "human_rule": "HERDAR MÉTODO ≠ HERDAR PERSONALIDADE",
    "method_transfer_without_personality_copy": true,
    "explicit_chief_intent_is_not_model_preference": true,
    "preference_is_not_universal_rule": true,
    "universalization_requires_scope_counterexample_test": true,
    "validated_learning_destination": "EXISTING_CANONICAL_ARTIFACT",
    "sequence": [
      "capture_exact_correction",
      "classify_correction",
      "identify_concrete_cause",
      "form_candidate_principle",
      "declare_scope",
      "seek_counterexample",
      "run_discriminating_test",
      "consolidate_or_reject"
    ],
    "classification": [
      "EXPLICIT_CHIEF_INTENT",
      "LOCAL_PREFERENCE",
      "TRANSFERABLE_PRINCIPLE",
      "HYPOTHESIS",
      "RUNTIME_DEPENDENCY"
    ],
    "decision_rules": {
      "explicit_chief_intent_applies_in_current_scope": true,
      "model_must_not_soften_explicit_chief_intent_for_convenience": true,
      "local_preference_becomes_universal_without_test": false,
      "personality_copy_required": false,
      "unproven_learning_becomes_gold": false,
      "validated_learning_updates_existing_canonical_artifact": true
    }
  },
  "internal_receipt_fields": [
    "USER_INTENT",
    "EXISTING_CAPABILITIES",
    "EVIDENCE_OPENED",
    "AUTHORITY_CLASSIFICATION",
    "REUSE_DECISION",
    "REAL_GAP",
    "MINIMAL_ACTION"
  ],
  "receipt_visibility": "INTERNAL_BY_DEFAULT; SHOW_ONLY_ON_AUDIT_OR_BLOCKER"
}
