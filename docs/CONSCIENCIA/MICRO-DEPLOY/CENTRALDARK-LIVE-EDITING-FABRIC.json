{
  "schema": "centraldark.live-editing-fabric.v1",
  "status": "CANONICAL_DEFAULT_WORK_MODE",
  "authority": "SEGREDO/CHEFE",
  "owner": "docs/CONSCIENCIA/MICRO-DEPLOY/",
  "mode": "CENTRALDARK_LIVE_EDITING_FABRIC",
  "default_loop": [
    "CHEFE_EDITA",
    "MAIN_OU_DELTA_RASTREAVEL",
    "SINGLE_REUSABLE_WORKTREE",
    "OWNER_EXATO",
    "TESTE_MINIMO_APLICAVEL",
    "MICRODEPLOY_CAUSAL",
    "RUNTIME_VIVO",
    "PROVA_DO_EFEITO",
    "RECEIPT",
    "REFINA",
    "COMPRIME",
    "PONTO_FIXO"
  ],
  "ci_policy": {
    "mvp_fast_loop_is_default": true,
    "deep_ci_loop_is_press_mode": true,
    "deep_ci_loop_requires_chefe_intent": true,
    "canonical_deploy_is_guard_not_default_brake": true
  },
  "scratch_worktree": {
    "canonical_path": "/root/CentralDark/_worktrees/main-pinned-runtime-fastpath",
    "single_reusable": true,
    "disposable": true,
    "lock_required": true,
    "reset_before_use": true,
    "reset_after_use": true,
    "dirty_handoff_forbidden": true,
    "runtime_is_not_scratch": true,
    "casa_is_not_scratch": true
  },
  "secret_transit": {
    "ephemeral_as_transit": true,
    "use_only_for_requested_owner": true,
    "no_secret_echo": true,
    "no_secret_commit": true,
    "no_secret_receipt_value": true,
    "no_secret_memory": true,
    "no_secret_log_value": true,
    "scrub_controlled_logs_after_use": true,
    "rotate_or_discard_after_use": true
  },
  "locks": {
    "unknown_is_not_pass": true,
    "action_is_not_proof": true,
    "merged_is_not_deployed": true,
    "documented_is_not_executed": true,
    "runtime_effect_required_for_runtime_claim": true,
    "gross_delta_allowed_in_fast_loop": true,
    "gross_delta_must_be_tracked_and_refined": true,
    "no_parallel_architecture": true,
    "no_unrelated_restart": true,
    "replay_before_rediscovery": true
  },
  "receipt_minimum_fields": [
    "START_HEAD",
    "SOURCE_SHA_OR_DELTA_REF",
    "OWNER",
    "FILESET_CAUSAL",
    "TESTS",
    "RUNTIME_EFFECT",
    "SECRET_EXPOSED=false",
    "RESULT",
    "NEXT_CURSOR"
  ]
}
