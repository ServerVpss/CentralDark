{
  "schema": "centraldark.modules.hub.trigger.domain_expansion.v1",
  "updated_at": "2026-09-24T12:08:00-03:00",
  "id": "domain-expansion",
  "canonical_phrase": "EXPANSAO DE DOMINIO",
  "aliases": [
    "expansao de dominio",
    "expansão de domínio",
    "expande o dominio",
    "expanda o dominio",
    "expansao do dominio",
    "expansão do domínio"
  ],
  "purpose": "Gatilho humano para continuar expandindo o Megazord CentralDark por setores, usando somente owners existentes, micro-deltas, CI e receipts.",
  "activation_semantics": {
    "mode": "deterministic_trigger",
    "when_detected": "continue_expandindo_o_dominio",
    "default_scope": "MODULES/HUB + owners reais conectados",
    "human_authority": "CHEFE/SEGREDO",
    "assistant_role": "SOL_COORDINATOR_AND_CONTRAPROVA",
    "executor_role": "Hermes/MCP/VPS quando disponivel",
    "judge": "Reality Judge",
    "not_a_ritual": true
  },
  "loop_contract": [
    "medir estado atual",
    "localizar owner existente",
    "deduplicar arquitetura",
    "selecionar menor setor conectavel",
    "criar micro-delta",
    "registrar commit atomico",
    "aguardar CI/checks quando existirem",
    "validar runtime/health quando aplicavel",
    "registrar receipt",
    "parar em PASS comprovado, UNKNOWN honesto ou bloqueio real"
  ],
  "allowed_expansion_sectors": [
    "github_actions",
    "gmail_signal",
    "telegram_bot_api",
    "telegram_mtproto",
    "mcp_gateway",
    "vps_pm2_runtime",
    "meta_lupa_reward",
    "status_centraldark_dashboard",
    "google_drive_ingest",
    "hub_connectors_ui",
    "obsidian_brain_sync",
    "ci_receipts"
  ],
  "commit_policy": {
    "micro_commits": true,
    "commit_only_material_delta": true,
    "do_not_commit_secrets": true,
    "prefer_existing_owner": true,
    "squash_when_yellow_too_long": "planned_manual_or_ci_safe_only",
    "do_not_merge_pending_ci_as_green": true
  },
  "proof_policy": {
    "notification_is_not_pass": true,
    "commit_is_not_deploy": true,
    "workflow_success_is_ci_pass_only": true,
    "runtime_health_requires_payload": true,
    "xp_requires_receipt": true,
    "unknown_is_not_pass": true
  },
  "stop_conditions": [
    "CI failed and root cause unknown",
    "owner existing but ambiguous",
    "secret or credential required",
    "runtime dirty diff would be overwritten",
    "human approval required for irreversible mutation"
  ],
  "outputs_required": [
    "commit_sha_or_noop_reason",
    "changed_files",
    "ci_or_status_state",
    "pass_unknown_blocked_split",
    "next_cursor"
  ]
}
