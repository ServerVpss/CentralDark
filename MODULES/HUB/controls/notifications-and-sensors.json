{
  "schema": "centraldark.modules.hub.controls.notifications_sensors.v1",
  "updated_at": "2026-09-30T08:07:00-03:00",
  "purpose": "Arquivo humano/editavel para ativar/desativar notificacoes, sensores de evento, canais de retorno e gatilhos de expansao. Nao guardar segredos aqui.",
  "global": {
    "default_enabled": true,
    "fail_closed": true,
    "emit_unknown_instead_of_pass": true,
    "require_receipt_for_score": true,
    "write_secrets_here": false
  },
  "triggers": {
    "domain_expansion": {
      "enabled": true,
      "canonical_phrase": "EXPANSAO DE DOMINIO",
      "trigger_file": "MODULES/HUB/triggers/domain-expansion.trigger.json",
      "playbook": "MODULES/HUB/playbooks/EXPANSAO-DE-DOMINIO.md",
      "mode": "deterministic_expansion_loop",
      "allow_micro_commits": true,
      "require_owner_lookup_before_create": true,
      "require_ci_or_receipt_before_pass": true,
      "allow_promote_notification_to_pass": false,
      "allow_parallel_brain": false,
      "default_output_format": "Feito/Evidencia/Pendencia/Proximo passo/Qual BOOT usar/Fio da missao"
    },
    "github_event_router": {
      "enabled": true,
      "owner_workflow": ".github/workflows/selo-fabric.yml",
      "source": "github.event_name",
      "mode": "event_name_then_owner_route",
      "classes": {
        "push": "CANONICAL_RECORD_ONLY",
        "check_suite": "CI_SENSOR",
        "workflow_run": "CI_SENSOR",
        "issues": "ISSUE_STATE_SENSOR",
        "issue_comment": "COMMENT_SENSOR",
        "pull_request": "PR_STATE_SENSOR",
        "pull_request_review": "PR_REVIEW_SENSOR",
        "pull_request_review_comment": "PR_REVIEW_SENSOR",
        "release": "RELEASE_SENSOR",
        "create": "REPOSITORY_EVENT_ONLY",
        "delete": "REPOSITORY_EVENT_ONLY",
        "deployment_status": "DEPLOY_SENSOR",
        "status": "CI_SENSOR",
        "schedule": "DETERMINISTIC_TRIGGER",
        "workflow_dispatch": "DETERMINISTIC_TRIGGER"
      },
      "unknown_event_route": "EVENT_ONLY",
      "event_is_not_pass": true,
      "event_is_not_authority": true,
      "owner_lookup_before_action": true,
      "self_echo_guard": true,
      "dedupe_marker": "CENTRALDARK_SELO_FABRIC"
    },
    "pr_conflict_gmail_hub_projection": {
      "enabled": true,
      "mode": "existing_owner_event_projection_only",
      "source_events": [
        "pull_request",
        "check_suite",
        "workflow_run"
      ],
      "source_owner": ".github/workflows/selo-fabric.yml",
      "conflict_owner": ".agents/skills/git-conflict-resolve-house-standard/SKILL.md",
      "conflict_adapter": ".agents/skills/centraldark-autonomous-conflict-costura/SKILL.md",
      "conflict_engine": "scripts/dependabot/resolve-conflicts.sh",
      "notification_owner": "src/lib/notifications-events.ts",
      "notification_ledger": "notifications_log",
      "hub_owner": "apps/modulos/hub",
      "cockpit_projection": "apps/instinto-superior/src/components/central/CockpitShell.tsx",
      "account_channel": "gmail_notifications",
      "dedupe_key": "repository:pr_number:head_sha:event_type",
      "statuses": [
        "CONFLICT_DETECTED",
        "OWNER_ASSIGNED",
        "RESOLUTION_IN_PROGRESS",
        "RESOLVED_PENDING_GATES",
        "GATES_FAILED",
        "GATES_PASSED",
        "DEPLOY_PROVEN",
        "UNKNOWN"
      ],
      "require_github_readback": true,
      "require_receipt_before_pass": true,
      "never_auto_merge_from_gmail": true,
      "never_promote_notification_to_pass": true,
      "allow_duplicate_resolver": false,
      "requires_runtime_adapter_validation": true,
      "proof_state": "CONFIGURED_NOT_RUNTIME_PROVEN",
      "notes": "Roteamento declarativo: o Hub de Contas projeta o evento; Gmail e canal de aviso, nao owner de resolucao. Preserva AutoSync e workflows existentes. Implementacao de runtime e teste E2E pendentes."
    }
  },
  "channels": {
    "telegram_bot_api": {
      "enabled": true,
      "notify_chefe": true,
      "allow_notes_to_brain": true,
      "allow_feedback_capture": true,
      "allow_xp_write": false,
      "reason_xp_write_disabled": "Adaptador CHEFE_FEEDBACK -> Meta-Lupa ainda nao implementado."
    },
    "telegram_mtproto": {
      "enabled": true,
      "notify_chefe": false,
      "requires_manual_login": true,
      "safe_health_without_config": true,
      "allow_start_confirm": false,
      "reason_start_confirm_disabled": "Ate configurar API_ID/API_HASH e confirmar conta pessoal fora do Git."
    },
    "github_actions": {
      "enabled": true,
      "notify_chefe": true,
      "treat_email_as_event_only": true,
      "query_github_before_score": true,
      "allow_auto_pass_from_email": false
    },
    "gmail_notifications": {
      "enabled": true,
      "notify_chefe": true,
      "treat_push_as_event_only": true,
      "allow_sensitive_content_ingest": false
    },
    "vps_pm2": {
      "enabled": true,
      "notify_chefe": true,
      "require_pm2_home": true,
      "allow_restart_without_owner": false,
      "allow_restart_after_dirty_diff": false
    },
    "mcp_health": {
      "enabled": true,
      "notify_chefe": true,
      "require_payload_validation": true,
      "admin_login_is_not_health": true
    },
    "status_centraldark": {
      "enabled": true,
      "notify_chefe": true,
      "publish_unknowns": true,
      "publish_pass_only_with_receipt": true,
      "show_toggle_controls": true,
      "show_domain_expansion_trigger": true
    },
    "meta_lupa_reward": {
      "enabled": true,
      "write_rewards": false,
      "manual_feedback_capture": true,
      "score_requires_receipt": true,
      "reason_write_rewards_disabled": "Precisa adaptador E2E para separar elogio, direcao correta e prova tecnica."
    }
  },
  "event_classification": {
    "notification": "EVENT_ONLY",
    "commit": "CANONICAL_RECORD_ONLY",
    "workflow_success": "CI_PASS_ONLY",
    "workflow_failure": "FAIL_OR_UNKNOWN",
    "runtime_health_payload": "RUNTIME_EVIDENCE",
    "chefe_feedback_positive": "HUMAN_FEEDBACK_ONLY",
    "chefe_feedback_negative": "HUMAN_FEEDBACK_ONLY",
    "domain_expansion_phrase": "DETERMINISTIC_TRIGGER",
    "receipt_with_head_pid_payload": "PROMOTABLE_EVIDENCE"
  },
  "github_event_router": {
    "purpose": "Classificacao de github.event_name como sensor/roteador. Evento NAO vira PASS sozinho. Resolve owner antes da acao. Falha de sensor/rota NAO vira falha do mundo.",
    "rules": {
      "event_is_not_pass": true,
      "resolve_owner_before_action": true,
      "sensor_failure_is_not_world_failure": true,
      "unknown_is_not_pass": true,
      "no_parallel_architecture": true
    },
    "selo_workflow": ".github/workflows/selo-fabric.yml",
    "groups": {
      "pr": {
        "events": [
          "pull_request",
          "pull_request_target",
          "pull_request_review",
          "pull_request_review_comment"
        ],
        "class": "PR_LIFECYCLE",
        "selo": true,
        "pulse_pr_mae": true,
        "existing_workflow": ".github/workflows/pr-mother-pulse.yml"
      },
      "ci": {
        "events": [
          "check_run",
          "check_suite",
          "workflow_run",
          "status"
        ],
        "class": "CI_EVIDENCE",
        "selo": true,
        "pulse_pr_mae": true,
        "pass_requires_receipt": true
      },
      "code": {
        "events": [
          "push",
          "create",
          "delete"
        ],
        "class": "CODE_MUTATION",
        "selo": true,
        "pulse_pr_mae": true
      },
      "issue": {
        "events": [
          "issues",
          "issue_comment"
        ],
        "class": "ISSUE_TRACKER",
        "selo": true,
        "pulse_pr_mae": true
      },
      "deploy": {
        "events": [
          "deployment",
          "deployment_status"
        ],
        "class": "DEPLOY_EVIDENCE",
        "selo": true,
        "pulse_pr_mae": true,
        "pass_requires_runtime_proof": true
      },
      "release": {
        "events": [
          "release"
        ],
        "class": "RELEASE_LIFECYCLE",
        "selo": true,
        "pulse_pr_mae": true
      },
      "trigger": {
        "events": [
          "workflow_dispatch",
          "repository_dispatch",
          "schedule"
        ],
        "class": "DETERMINISTIC_TRIGGER",
        "selo": true,
        "pulse_pr_mae": false
      },
      "repo_admin": {
        "events": [
          "branch_protection_rule",
          "member",
          "public",
          "fork"
        ],
        "class": "REPO_ADMIN_EVENT",
        "selo": false,
        "pulse_pr_mae": false
      },
      "project": {
        "events": [
          "project",
          "project_card",
          "project_column",
          "milestone",
          "label"
        ],
        "class": "PROJECT_MANAGEMENT",
        "selo": false,
        "pulse_pr_mae": false
      },
      "content": {
        "events": [
          "discussion",
          "discussion_comment",
          "wiki",
          "page_build"
        ],
        "class": "CONTENT_EVENT",
        "selo": false,
        "pulse_pr_mae": false
      },
      "registry": {
        "events": [
          "registry_package"
        ],
        "class": "PACKAGE_EVENT",
        "selo": true,
        "pulse_pr_mae": false
      },
      "watch": {
        "events": [
          "watch",
          "star"
        ],
        "class": "VANITY_METRIC",
        "selo": false,
        "pulse_pr_mae": false
      }
    }
  },
  "dispatch": {
    "owner": "supabase/functions/_shared/notifications-events.ts",
    "central_ledger": "notifications_log",
    "cockpit_consumer": "apps/instinto-superior/src/hooks/useNotificationsLog.ts",
    "delivery_modes": [
      "single",
      "parallel"
    ],
    "default_target": "cockpit_admin",
    "routes_owner": "notification_routes",
    "targets": {
      "cockpit_admin": {
        "status": "UI_BRANCH_UNPROVEN",
        "permission": "RLS_ADMIN"
      },
      "telegram": {
        "status": "EXISTING_ROUTE_RUNTIME_UNPROVEN",
        "owner": "supabase/functions/notify-telegram/index.ts"
      },
      "cockpit_sector": {
        "status": "ADAPTER_REQUIRED"
      },
      "harness_specialist": {
        "status": "ADAPTER_REQUIRED"
      },
      "hermes_executor": {
        "status": "ADAPTER_REQUIRED"
      }
    },
    "notifications_are_not_execution": true,
    "agent_dispatch_requires_authorized_adapter": true,
    "parallel_requires_per_target_receipt": true,
    "never_notify_chatgpt_thread": true,
    "no_external_session_token_transfer": true,
    "dedupe_before_fanout": true
  }
}
