  "authorization_phrase": "PERMITO SEGREDO",
  "authority": "SEGREDO/CHEFE",
  "criticality": "CRITICAL",
  "description": "User authentication gateway, API routing, session management",
  "protected_operations": [
    "restart",
    "stop",
    "update_config",
    "delete_logs",
    "scale",
    "delete_process"
  ],
  "rules": {
    "cooldown_seconds": 30,
    "max_restarts_per_day": 5,
    "require_reason_on_stop": true,
    "require_backup_on_config_update": true,
    "require_test_on_config_update": true,
    "zero_regression_enforced": true,
    "one_writer_per_scope": true
  },
  "monitoring": {
    "health_check_interval_seconds": 60,
    "auto_restart_on_crash": true,
    "max_crash_restarts": 3,
    "max_crash_restarts_window_hours": 24,
    "failover_pool": [
      "CentralDark-Hermes-acp-1",
      "CentralDark-Hermes-acp-2",
      "CentralDark-Hermes-acp-3"
    ],
    "failover_timeout_seconds": 10,
    "graceful_shutdown_timeout_seconds": 15
  },
  "alerting": {
    "channels": [
      "telegram:@srver1bot",
      "github:issues",
      "logs:/var/log/centraldark-hermes-audit.log"
    ],
    "alert_on": [
      "unauthorized_access_attempt",
      "operation_requested",
      "operation_authorized",
      "operation_started",
      "operation_completed",
      "operation_failed",
      "crash_detected",
      "failover_triggered",
      "health_check_failed"
    ]
  },
  "audit": {
    "log_file": "/var/log/centraldark-hermes-audit.log",
    "retention_days": 90,
    "rotation_policy": "daily",
    "max_size_mb": 500,
    "fields": [
      "timestamp_utc",
      "operator",
      "operation_type",
      "process_name",
      "authorization_evidence",
      "reason",
      "status",
      "result_code",
      "duration_ms",
      "notes"
    ]
  },
