{
  "name": "centraldark-remote-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "HUD e bandeja do Remote Bridge CentralDark",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs"
  },
  "dependencies": {
    "lucide-react": "0.553.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.1.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "vite": "7.3.7"
  },
  "build": {
    "appId": "com.centraldark.remotebridge",
    "productName": "CentralDark Remote Bridge",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../CentralDark-Remote-Bridge.ps1",
        "to": "bridge/CentralDark-Remote-Bridge.ps1"
      },
      {
        "from": "../canonical/CENTRALDARK-OAUTH-TRAY.ps1",
        "to": "bridge/CENTRALDARK-OAUTH-TRAY.ps1"
      }
    ],
    "win": {
      "executableName": "CentralDark-Remote-Bridge",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "CentralDark-Remote-Bridge-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
