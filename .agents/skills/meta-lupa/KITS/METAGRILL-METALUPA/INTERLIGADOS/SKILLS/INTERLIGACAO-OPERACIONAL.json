    "INTERLIGADOS != LOAD_ALL_SKILLS",
    "SKILL_GRAPH != SECOND_ROUTER",
    "SKILL_MD + INTERLIGADOS_MD != SECOND_OWNER",
    "MENTAL_TRIGGER != PRIVATE_CHAIN_OF_THOUGHT",
    "VISIBLE_OPERATIONAL_TRACE != PRIVATE_CHAIN_OF_THOUGHT",
    "EMOJI != PROOF",
    "MODEL != AUTHORITY",
    "CAPABILITY != AUTHORITY",
    "ONE_WRITER_PER_SCOPE=true",
