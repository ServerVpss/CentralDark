{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "centraldark://lupa/n7/conversor",
  "title": "ConversorN7Response",
  "frozen": true,
  "type": "object",
  "required": ["agent", "precedence", "erro_convertido", "hipotese", "lupa_trace"],
  "properties": {
    "agent": {"const": "conversor"},
    "precedence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "erro_convertido": {"type": "object", "required": ["descricao", "evidencia_ref"]},
    "hipotese": {"type": "string", "minLength": 8},
    "lupa_trace": {"type": "array", "items": {"type": "object"}, "minItems": 3}
  },
  "additionalProperties": false
}
