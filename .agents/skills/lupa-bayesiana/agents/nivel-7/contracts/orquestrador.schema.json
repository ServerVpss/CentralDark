{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "centraldark://lupa/n7/orquestrador",
  "title": "OrquestradorN7Response",
  "frozen": true,
  "type": "object",
  "required": ["agent", "precedence", "decisao", "convocados", "ledger_ref", "lupa_trace"],
  "properties": {
    "agent": {"const": "orquestrador"},
    "precedence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "decisao": {"enum": ["EXECUTAR", "PARAR", "REFINAR"]},
    "convocados": {"type": "array", "items": {"enum": ["observador", "conversor"]}, "minItems": 1},
    "ledger_ref": {"type": "string", "pattern": "^evidence/ledger.jsonl#L[0-9]+$"},
    "lupa_trace": {"type": "array", "items": {"type": "object"}, "minItems": 3}
  },
  "additionalProperties": false
}
